{
  "name": "@happydoran/stackflow-kit",
  "private": false,
  "version": "0.1.0",
  "description": "Runtime-agnostic StackFlow navigation lock, guarded actions, swipe-back, and screen adapters for React.",
  "keywords": [
    "stackflow",
    "react",
    "navigation",
    "swipe-back"
  ],
  "homepage": "https://github.com/HappyDoran/stackflow-kit#readme",
  "bugs": {
    "url": "https://github.com/HappyDoran/stackflow-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HappyDoran/stackflow-kit.git"
  },
  "author": "Dongwon Seo",
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./navigation-lock": {
      "types": "./dist/navigation-lock.d.ts",
      "import": "./dist/navigation-lock.js",
      "default": "./dist/navigation-lock.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "styles.css"
  ],
  "sideEffects": [
    "./styles.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "@stackflow/react": "^1.12.0",
    "@stackflow/react-ui-core": "^1.3.3",
    "react": ">=19.0.0 <20.0.0"
  },
  "devDependencies": {
    "@stackflow/react": "1.12.0",
    "@stackflow/react-ui-core": "1.3.3",
    "@types/react": "19.2.0",
    "react": "19.2.3",
    "typescript": "^5.8.3"
  }
}
